 "sections": {
  "news": {
   "briefing": [
    {
     "text": "Emerging-market equities rallied as Nvidia CEO Jensen Huang’s return revived investor enthusiasm for the AI trade.",
     "sources": [
      {
       "key": "2693be46639a9afa",
       "title": "Emerging Market Stocks Rally as Huang’s Return Revives AI Trade - Bloomberg.com",
       "url": "https://news.google.com/rss/articles/CBMitAFBVV95cUxQbl9tOWRvMDhVMFR5RW1QeEhJMG1IOVhkNEdRUGdjYmtIbUpLbTV2dnltRXAwWEgxb2pObDRiRlJlLWx0d1VQdXNXdTc2MWFBeHBBTm9fTTVEOWVXcUJOcmRQQWN5Mk9iNXBPV19WcDI5R0FDZERHR25qSC1fc1lnOURmTmlvU1NRTUNSOWZFODhKZFFPLWZlY3JiTll1NVVQR0V4UzFSNS1hM28tWG5nN3Y3TGQ?oc=5",
       "source": "Bloomberg.com",
       "via": "Google News"
      }
     ]
    },
    {
     "text": "Shenzhen districts have formed what China Daily describes as China’s first insurance consortium focused on the AI industry, a notable development at the intersection of insurance and AI.",
     "sources": [
      {
       "key": "c9239eab66537e59",
       "title": "Shenzhen districts establish China's first AI industry insurance consortium - China Daily Global Edition",
       "url": "https://news.google.com/rss/articles/CBMiggFBVV95cUxNYXpYVHdhdzRmMmhFVzVtNUw4RWRndzZYT3pETWN2ZU1TX0VzNTYzMUVYakl6SlJxaVg0VGlnMmNTVkJGT2NxMEExTW8tNW1DVmtGQk5rWnRFLTRLdjZCcGc3dUNMamdwTGNYR09CNmkwaG4yb0t6VmxleXRyVzYySE1n?oc=5",
       "source": "China Daily Global Edition",
       "via": "Google News"
      }
     ]
    },
    {
     "text": "Meta has launched Muse, an AI agent in the UK designed to handle Christmas shopping, bringing agentic AI into consumer commerce.",
     "sources": [
      {
       "key": "1578070c5a50c444",
       "title": "Meta launches Muse in UK – the AI agent that can do your Christmas shopping - The Guardian",
       "url": "https://news.google.com/rss/articles/CBMipgFBVV95cUxNYnNPV3c5WnFtTU5oUUFrMDU5ZXpxTWljNm9hZHhlUFFtNDBEclNETVF5RGc1ei04dlNPbGZLazJRLUEwMkdCbDZkckE1UUNBU1R3QkpYR3JORDZkNnJMckFCelFldldjRElLWmxLbllyNHU3cFQ2d1AwMGItU205eWhRZFF2WFd1MFdTbzVBNXBGdTdiVlhEaWVrZnZUN2V0SFpOSFFn?oc=5",
       "source": "The Guardian",
       "via": "Google News"
      }
     ]
    },
    {
     "text": "The ECB’s new leadership team faces a demanding start, though the available report provides no detail on policy implications.",
     "sources": [
