 "sections": {
  "news": {
   "briefing": [
    {
     "text": "US technology shares are under heavy pressure: the Nasdaq is reported down 5%, amid concerns about tougher AI regulation after the midterm results.",
     "sources": [
      {
       "key": "dcb771ac66309941",
       "title": "Nasdaq heading for worst day in 18 months as Wall Street sustains widespread losses",
